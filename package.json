{
  "name": "qeva",
  "version": "1.0.0",
  "private": true,
  "description": "Qeva Enterprise Password Manager",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "dev:https": "node server.js",
    "start:https": "NODE_ENV=production node server.js",
    "seed:roles": "node scripts/seed-roles.js",
    "seed:categories": "node scripts/seed-categories.js",
    "seed:all": "node scripts/seed-roles.js && node scripts/seed-categories.js",
    "seed:demo": "node scripts/seed-roles.js && node scripts/seed-categories.js && node scripts/seed-demo.js",
    "setup:db": "node scripts/setup-database.js",
    "sync:roles": "node scripts/sync-all-users-roles.js",
    "studio": "npx prisma studio -p 3110",
    "postinstall": "prisma generate",
    "lint": "next lint",
    "selfcheck": "node scripts/selfcheck-crypto.js && node scripts/selfcheck-reports.js && node scripts/selfcheck-agent-clients.js && node scripts/selfcheck-service-probe.js && node scripts/selfcheck-sso-providers.js && node scripts/selfcheck-browser-import.js && node scripts/selfcheck-selfhost.js && node scripts/selfcheck-edition.js && node scripts/selfcheck-audit.js",
    "test:crypto": "node scripts/selfcheck-crypto.js",
    "test:reports": "node scripts/selfcheck-reports.js",
    "test:agents": "node scripts/selfcheck-agent-clients.js",
    "test:service-probe": "node scripts/selfcheck-service-probe.js",
    "qeva": "node agents/qeva.mjs",
    "logs": "Get-Content -Path logs/*.log -Tail 50 -Wait"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.4.0",
    "@hookform/resolvers": "^5.2.2",
    "@noble/hashes": "^2.4.0",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.95.2",
    "@types/pg": "^8.20.0",
    "argon2": "^0.41.1",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "framer-motion": "^11.18.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.427.0",
    "marked": "^16.4.0",
    "mssql": "^12.0.0",
    "next": "^14.2.33",
    "next-auth": "^4.24.7",
    "next-themes": "^0.4.6",
    "node-schedule": "^2.1.1",
    "nodemailer": "^7.0.7",
    "pg": "^8.20.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.72.0",
    "react-hot-toast": "^2.4.1",
    "recharts": "^3.2.1",
    "sonner": "^2.0.7",
    "speakeasy": "^2.0.0",
    "tailwind-merge": "^2.5.2",
    "tailwindcss-animate": "^1.0.7",
    "winston": "^3.18.3",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/mssql": "^9.1.5",
    "@types/node": "^20.14.0",
    "@types/node-schedule": "^2.1.8",
    "@types/nodemailer": "^6.4.15",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/speakeasy": "^2.0.10",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.33",
    "postcss": "^8.4.38",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.5"
  }
}
