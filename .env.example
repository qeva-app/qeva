# Copy to .env and fill in before `docker compose up`.
# Generate secrets: openssl rand -base64 32

# Edition: community (CE Docker — individuals only) | enterprise (company/org features)
# Community: personal vault only; no company signup, teams, SSO, SCIM, SIEM, alerts
QEVA_EDITION=community

# Public URL of this Qeva instance (no trailing slash)
NEXTAUTH_URL=http://localhost:3100

# Required secrets (min 32 chars recommended)
NEXTAUTH_SECRET=
ENCRYPTION_KEY=
JWT_SECRET=
# Optional: PEM PKCS8 private key. Docker generates + persists one under /app/certs if unset.
# RSA_PRIVATE_KEY=

# Super admin email (also a Docker build-arg). Password is generated on first boot
# unless BOOTSTRAP_ADMIN_PASSWORD is set. Grab it once:
#   docker compose logs qeva | grep QEVA_BOOTSTRAP_PASSWORD
SUPER_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Admin

# ── Database ───────────────────────────────────────────────
# Bundled Postgres (docker compose --profile bundled):
DB_PASSWORD=YourStrong!Password123
#
# External Postgres/Supabase only (skip --profile bundled):
# QEVA_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
# Do not set a host-level DATABASE_URL to localhost — it breaks the container.

# Inbox for marketing Contact Us form (falls back to SUPER_ADMIN_EMAIL)
# CONTACT_INBOX=hello@example.com

# SMTP (optional — without it, invite/reset emails are logged only)
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM=noreply@qeva.local

# Set true only behind a TLS reverse proxy that sets X-Forwarded-Proto
# FORCE_HTTPS=true
