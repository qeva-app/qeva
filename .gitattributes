# Normalize text; keep scripts LF for Linux containers
* text=auto eol=lf

*.sh text eol=lf
docker-entrypoint.sh text eol=lf

*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
